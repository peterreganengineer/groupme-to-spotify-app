# Make sure you're on main
git checkout main

# Delete all local branches except main
git branch -D $(git branch | grep -v 'main')

# Delete all remote branches except main
git push origin $(git branch -r | grep 'origin/' | sed 's|origin/||' | grep -v 'main\|HEAD' | tr '\n' ' ' | sed 's/ /:/' | sed 's/ / --delete origin\//g')# Make sure you're on main
